# ==============================================================================
# QueueLess — Environment Configuration Template
# Copy this file to .env in your root or server directory before deployment.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# Security & Authentication
# Generate a cryptographically secure random string (e.g., openssl rand -base64 32)
JWT_SECRET=replace_with_a_secure_random_secret_in_production

# Frontend API Target (Vite client-side)
# - Leave blank/unset if deploying frontend & backend together on Vercel (uses relative /api)
# - Set to your dedicated backend URL if deploying backend on Render/Railway/Fly/VPS:
#   Example: VITE_API_URL=https://queueless-api.onrender.com
VITE_API_URL=

# SQLite Database Path (Optional override)
# - In standard container/server: defaults to server/queueless.db
# - On Vercel serverless: defaults to /tmp/queueless.db
# DATABASE_PATH=/path/to/persistent/queueless.db
