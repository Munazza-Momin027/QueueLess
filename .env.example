# ==============================================================================
# QueueLess — Environment Configuration Template
# Copy this file to .env in your root or server directory before deployment.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# Security & Authentication
# Generate a cryptographically secure random string (e.g., openssl rand -base64 32)
JWT_SECRET=replace_with_a_secure_random_secret_in_production

# Client Proxy URL (optional, for custom reverse proxies)
VITE_API_URL=http://localhost:5000
