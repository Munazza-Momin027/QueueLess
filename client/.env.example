# ==============================================================================
# QueueLess Client — Environment Configuration Template
# ==============================================================================

# Backend API Origin URL (Optional in production)
# - Leave blank/unset when using Vercel single-project deployment (routes to relative /api)
# - Set to your dedicated backend URL if backend is hosted on Render, Railway, or VPS:
#   Example: VITE_API_URL=https://queueless-api.onrender.com
VITE_API_URL=

# Local development proxy override (Optional, defaults to http://localhost:5000)
# VITE_DEV_API_PROXY=http://localhost:5000
